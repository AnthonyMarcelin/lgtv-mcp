# LG TV network
LGTV_HOST=192.168.1.x
LGTV_MAC=AA:BB:CC:DD:EE:FF
LGTV_BROADCAST=192.168.1.255
# Optional: override packaged unsigned manifest_comp.json
# LGTV_MANIFEST_PATH=
# Optional: extra pair permissions (re-pair with --force). Example for settings writes:
# LGTV_EXTRA_PERMISSIONS=WRITE_NOTIFICATION_ALERT,WRITE_SETTINGS

# MCP HTTP server
MCP_BIND_HOST=0.0.0.0
MCP_PORT=8765
# Required. Generate a long random string. Never commit the real value.
MCP_BEARER_TOKEN=change-me-to-a-long-random-secret

# Persistent data (pairing key + backups)
DATA_DIR=/data
